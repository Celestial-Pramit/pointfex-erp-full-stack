# Pointfex ERP Frontend — Public Environment Variables ONLY
# Never place secrets, API keys, or credentials in VITE_* variables.

# API Base URL (defaults to /api when using reverse proxy or Vite dev proxy)
# Can be configured as "/api" or full URL "http://localhost:3000/api" / "https://api.yourdomain.com/api"
VITE_API_URL="/api"
VITE_API_BASE_URL="/api"
